RewriteEngine On

# API routes are hosted on Vercel. If the browser still requests /api/* on this host, return 404.
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^ - [R=404,L]

# 1) Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2) Redirect non-www to www for swatikasarees.com
RewriteCond %{HTTP_HOST} ^swatikasarees\.com$ [NC]
RewriteRule ^ https://www.swatikasarees.com%{REQUEST_URI} [R=301,L]

# 3) Remove explicit index.html from URLs
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# 4) If the request matches an existing file or directory directly, serve it immediately
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5) If request matches a directory with index.html (e.g. /cart/index.html when requesting /cart)
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)/?$ $1/index.html [L]

# 6) If request matches an exported HTML file (e.g. /cart.html when requesting /cart)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)/?$ $1.html [L]

