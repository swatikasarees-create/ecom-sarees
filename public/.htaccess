RewriteEngine On

# API routes are hosted on Vercel (see NEXT_PUBLIC_API_BASE_URL). If the browser still
# requests /api/* on this host, do not chain HTML rewrites — return 404.
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^ - [R=404,L]

# 1) Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2) Force single host (www canonical)
RewriteCond %{HTTP_HOST} !^www\.swatikasarees\.com$ [NC]
RewriteRule ^ https://www.swatikasarees.com%{REQUEST_URI} [R=301,L]

# 3) Remove explicit index.html from URLs
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# 4) Convert pseudo-route directories (/suit/) to route files (/suit)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}index.html !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 5) Remove trailing slash on non-directory URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 6) Serve exported HTML for extensionless paths
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]
